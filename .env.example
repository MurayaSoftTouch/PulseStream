# PulseStream local development configuration.
# Copy to `.env` (git-ignored). Every value below is a LOCAL-ONLY placeholder.

# API listen address. Loopback by default; bind wider only deliberately.
PULSESTREAM_API_BIND=127.0.0.1:8088

# PostgreSQL connection (docker compose service `postgres`). Required by the
# API and the worker. Never logged.
DATABASE_URL=postgres://pulsestream:pulsestream_local_dev_only@127.0.0.1:55432/pulsestream
# Pool size per process: 1-50. Acquire/connect timeout (ms): 100-60000.
PULSESTREAM_DB_MAX_CONNECTIONS=10
PULSESTREAM_DB_ACQUIRE_TIMEOUT_MS=3000
# Apply embedded migrations at startup: true or false.
PULSESTREAM_MIGRATE_ON_START=true

# Worker. Concurrency: 1-64. Poll interval (ms): 10-60000.
# Processing lease (ms): 1000-3600000. Shutdown timeout (ms): 1-300000.
PULSESTREAM_WORKER_CONCURRENCY=4
PULSESTREAM_POLL_INTERVAL_MS=250
PULSESTREAM_PROCESSING_LEASE_MS=30000
PULSESTREAM_SHUTDOWN_TIMEOUT_MS=10000

# Real-PostgreSQL tests only. The database name must end in `_test`; each test
# creates and drops its own `<name>_<hex>` database. Never point this at real data.
PULSESTREAM_TEST_DATABASE_URL=postgres://pulsestream:pulsestream_local_dev_only@127.0.0.1:55432/pulsestream_test

# Consumed by docker compose for the local database container.
POSTGRES_USER=pulsestream
POSTGRES_PASSWORD=pulsestream_local_dev_only
POSTGRES_DB=pulsestream
PULSESTREAM_POSTGRES_PORT=55432

# Log filter (tracing-subscriber EnvFilter syntax). Defaults to `info` when unset.
RUST_LOG=info
